{
  "expo": {
    "name": "UbiLife",
    "slug": "UbiLife",
    "version": "1.0.0",
    "orientation": "portrait",
"icon": "./assets/images/Logo.png",
      "scheme": "front",
      "userInterfaceStyle": "automatic",
      "newArchEnabled": true,
      "ios": {
        "supportsTablet": true,
        "package": "com.andresga500.ubilife"
      },
      "notifications": {
        "icon": "./assets/images/Logo.png",
        "color": "#E6F4FE",
        "androidMode": "default",
        "androidCollapsedTitle": "New notification"
      },
      "android": {
        "adaptiveIcon": {
          "backgroundColor": "#E6F4FE",
          "foregroundImage": "./assets/images/Logo.png",
          "package": "com.andresga500.ubilife"
        },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "UbiLife necesita tu ubicación para mostrarte en el mapa junto al paciente."
        }
        ],
        [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
        ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93fbe208-0347-47c4-ab70-943f62e1e27e"
      }
    },
    "owner": "andresga500"
  }
}
